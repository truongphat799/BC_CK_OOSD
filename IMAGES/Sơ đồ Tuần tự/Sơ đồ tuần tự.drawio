        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml SD02_ThongTinCaNhan\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam defaultFontSize 11\nskinparam backgroundColor white\nskinparam sequence {\n    ArrowColor #990033\n    ActorBorderColor #990033\n    LifeLineBorderColor #990033\n    LifeLineBackgroundColor white\n    ParticipantBorderColor #990033\n    ParticipantBackgroundColor #FFFEE0\n    ActorBackgroundColor #FFFEE0\n    GroupBorderColor #990033\n    GroupBackgroundColor transparent\n    GroupHeaderFontColor #990033\n}\n\nactor \&quot;: NhanVien\&quot; as NV\nboundary \&quot;: FrmThongTinCaNhan\&quot; as Form\ncontrol \&quot;: NguoiDungService\&quot; as Service\nentity \&quot;: NguoiDung\&quot; as User\n\nNV -&gt; Form : chonXemThongTinCaNhan()\nactivate Form\nForm -&gt; Service : layThongTin(maNguoiDung)\nactivate Service\nService -&gt; User : timTheoMa(maNguoiDung)\nactivate User\nUser --&gt; Service : duLieuUser\ndeactivate User\nService --&gt; Form : traVeThongTin(duLieuUser)\ndeactivate Service\nForm --&gt; NV : hienThiThongTin(hoTen, email, sdt, vaiTro)\n\nNV -&gt; Form : nhapDoiMatKhau(mkCu, mkMoi, xacNhanMK)\nNV -&gt; Form : nhan \&quot;Luu thay doi\&quot;\nForm -&gt; Service : doiMatKhau(maNguoiDung, mkCu, mkMoi, xacNhanMK)\nactivate Service\n\nService -&gt; Service : kiemTraTrungKhop(mkMoi, xacNhanMK)\nService -&gt; User : xacThucMatKhauCu(maNguoiDung, mkCu)\nactivate User\nUser --&gt; Service : ketQuaXacThuc\ndeactivate User\n\nalt [mkCu dung va mkMoi hop le]\n    Service -&gt; User : capNhatMatKhau(maNguoiDung, hash(mkMoi))\n    activate User\n    User --&gt; Service : capNhatThanhCong\n    deactivate User\n    Service --&gt; Form : KetQua.Ok\n    Form --&gt; NV : Thong bao doi mat khau thanh cong\nelse [mkCu sai hoac mkMoi khong hop le]\n    Service --&gt; Form : KetQua.Fail(\&quot;Mật khẩu không hợp lệ\&quot;)\n    Form --&gt; NV : Thong bao loi\nend\n\ndeactivate Service\ndeactivate Form\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="bJYk1_qReCB-1f-y8KGN-1">
