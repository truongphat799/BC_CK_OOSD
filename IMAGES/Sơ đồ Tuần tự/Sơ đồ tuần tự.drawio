        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml SD13_KiemKeTaiSan\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam defaultFontSize 11\nskinparam backgroundColor white\nskinparam sequence {\n    ArrowColor #990033\n    ActorBorderColor #990033\n    LifeLineBorderColor #990033\n    LifeLineBackgroundColor white\n    ParticipantBorderColor #990033\n    ParticipantBackgroundColor #FFFEE0\n    ActorBackgroundColor #FFFEE0\n    GroupBorderColor #990033\n    GroupBackgroundColor transparent\n    GroupHeaderFontColor #990033\n}\n\nactor \&quot;: QuanLy\&quot; as QL\nactor \&quot;: NVQuanLyTaiSan\&quot; as NV\nboundary \&quot;: FrmKiemKe\&quot; as Form\ncontrol \&quot;: KiemKeService\&quot; as Service\nentity \&quot;: PhieuKiemKe\&quot; as Phieu\nentity \&quot;: ChiTietKiemKe\&quot; as CT\nentity \&quot;: TaiSan\&quot; as TS\n\nQL -&gt; Form : moLapPhieuKiemKe()\nactivate Form\nForm --&gt; QL : hienThiBieuMauBM6(maPhieuKKTuDong)\n\nQL -&gt; Form : nhapDotKiemKe, chonPhongBan(maPB), nhapBanKiemKe\nQL -&gt; Form : nhan \&quot;Khoi tao dot kiem ke\&quot;\n\nForm -&gt; Service : khoiTaoKiemKe(dotKK, maPB, banKK)\nactivate Service\nService -&gt; Phieu : khoiTaoDotKiemKe(maPhieuKK, ngayKK, dotKK, maPB)\nactivate Phieu\nPhieu --&gt; Service : phieuKiemKeDaTao\ndeactivate Phieu\n\nService -&gt; TS : laySoLuongSoSach(maPB)\nactivate TS\nTS --&gt; Service : dsTaiSanSoSach\ndeactivate TS\nService --&gt; Form : bangKiemKeSoSach(dsTaiSanSoSach)\ndeactivate Service\nForm --&gt; QL : hienThiBangDoiSoat()\n\n== Giai doan kiem dem thuc te ==\n\nloop [NV QLTS kiem dem tung tai san]\n    NV -&gt; Form : nhapSoLuongThucTe(maTS, slThucTe, tinhTrang)\n    Form -&gt; Service : capNhatKiemDem(maPhieuKK, maTS, slThucTe, tinhTrang)\n    activate Service\n    Service -&gt; Service : tinhChenhLech = slThucTe - slHeThong\n    Service -&gt; CT : taoChiTietKiemKe(maPhieuKK, maTS, slHeThong, slThucTe, chenhLech, tinhTrang)\n    activate CT\n    CT --&gt; Service : ok\n    deactivate CT\n    Service --&gt; Form : ketQuaDong(chenhLech)\n    deactivate Service\nend\n\nQL -&gt; Form : xemTongHopChenhLech()\nQL -&gt; Form : nhapDeXuatXuLy()\nQL -&gt; Form : nhan \&quot;Luu ket qua kiem ke\&quot;\n\nForm -&gt; Service : luuKetQua(maPhieuKK, ghiChuChung)\nactivate Service\nService -&gt; Phieu : luuKetQua(maPhieuKK, ghiChuChung)\nactivate Phieu\nPhieu --&gt; Service : daLuu\ndeactivate Phieu\nService --&gt; Form : KetQua.Ok\ndeactivate Service\nForm --&gt; QL : Thong bao hoan tat kiem ke\ndeactivate Form\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="LoWV8JiZwU6ryHO7erUt-1">
