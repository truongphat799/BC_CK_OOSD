        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml SD08_GhiNhanDonViSuDung\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam defaultFontSize 11\nskinparam backgroundColor white\nskinparam sequence {\n    ArrowColor #990033\n    ActorBorderColor #990033\n    LifeLineBorderColor #990033\n    LifeLineBackgroundColor white\n    ParticipantBorderColor #990033\n    ParticipantBackgroundColor #FFFEE0\n    ActorBackgroundColor #FFFEE0\n    GroupBorderColor #990033\n    GroupBackgroundColor transparent\n    GroupHeaderFontColor #990033\n}\n\ncontrol \&quot;: CapPhatService\&quot; as Caller\ncontrol \&quot;: GhiNhanSuDungService\&quot; as Service\nentity \&quot;: PhongBan\&quot; as PB\nentity \&quot;: NguoiDung\&quot; as User\nentity \&quot;: TaiSan\&quot; as TS\n\nCaller -&gt; Service : ghiNhanSuDung(maTS, maPB, maNV, viTriMoi)\nactivate Service\n\nService -&gt; PB : kiemTraPhongBan(maPB)\nactivate PB\nPB --&gt; Service : phongBanHopLe\ndeactivate PB\n\nService -&gt; User : kiemTraNguoiDung(maNV)\nactivate User\nUser --&gt; Service : nguoiDungHopLe\ndeactivate User\n\nalt [phongBan va nguoiDung hop le]\n    Service -&gt; TS : capNhatDonViQuanLy(maTS, maPB)\n    activate TS\n    TS --&gt; Service : ok\n    deactivate TS\n    \n    Service -&gt; TS : capNhatNguoiPhuTrach(maTS, maNV)\n    activate TS\n    TS --&gt; Service : ok\n    deactivate TS\n    \n    Service -&gt; TS : capNhatViTri(maTS, viTriMoi)\n    activate TS\n    TS --&gt; Service : ok\n    deactivate TS\n    \n    Service -&gt; Service : ghiNhanLichSuPhanBo(maTS, maPB, maNV, ngayHienTai)\n    Service --&gt; Caller : KetQua.Ok\nelse [phongBan hoac nguoiDung khong hop le]\n    Service --&gt; Caller : KetQua.Fail(\&quot;Đơn vị hoặc người nhận không hợp lệ\&quot;)\nend\n\ndeactivate Service\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fJOjXfOYiKHS3S4oM6dz-1">
