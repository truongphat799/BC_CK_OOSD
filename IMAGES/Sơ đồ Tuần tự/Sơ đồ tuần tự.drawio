        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml SD05_TiepNhanLoaiTS\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam defaultFontSize 11\nskinparam backgroundColor white\nskinparam sequence {\n    ArrowColor #990033\n    ActorBorderColor #990033\n    LifeLineBorderColor #990033\n    LifeLineBackgroundColor white\n    ParticipantBorderColor #990033\n    ParticipantBackgroundColor #FFFEE0\n    ActorBackgroundColor #FFFEE0\n    GroupBorderColor #990033\n    GroupBackgroundColor transparent\n    GroupHeaderFontColor #990033\n}\n\nactor \&quot;: NVQuanLyTaiSan\&quot; as NV\nboundary \&quot;: FrmLoaiTaiSan\&quot; as Form\ncontrol \&quot;: LoaiTaiSanService\&quot; as Service\nentity \&quot;: LoaiTaiSan\&quot; as Loai\n\nNV -&gt; Form : chonTiepNhanLoaiTS()\nactivate Form\nForm --&gt; NV : hienThiBieuMauBM1()\n\nNV -&gt; Form : nhapThongTin(maLoai, tenLoai, tyLeKhauHao, thoiGianSD, ghiChu)\nNV -&gt; Form : nhan \&quot;Luu loai tai san\&quot;\nForm -&gt; Service : themLoaiTaiSan(duLieuLoaiTS)\nactivate Service\n\nService -&gt; Service : kiemTraDuLieu(tyLeKhauHao &gt; 0 &amp;&amp; tyLeKhauHao &lt;= 100)\nService -&gt; Loai : kiemTraTrungMa(maLoai)\nactivate Loai\nLoai --&gt; Service : daTonTai\ndeactivate Loai\n\nalt [maLoai chua ton tai va du lieu hop le]\n    Service -&gt; Loai : themLoaiTS(maLoai, tenLoai, tyLeKhauHao, thoiGianSD, ghiChu)\n    activate Loai\n    Loai --&gt; Service : loaiTSDaLuu\n    deactivate Loai\n    Service --&gt; Form : KetQua.Ok\n    Form --&gt; NV : Thong bao tiep nhan loai tai san thanh cong\nelse [maLoai da ton tai hoac tyLe khong hop le]\n    Service --&gt; Form : KetQua.Fail(\&quot;Mã loại trùng hoặc tỷ lệ không hợp lệ\&quot;)\n    Form --&gt; NV : Thong bao loi\nend\n\ndeactivate Service\ndeactivate Form\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="u7jVYIQ614ZfHX2jl1Fv-1">
