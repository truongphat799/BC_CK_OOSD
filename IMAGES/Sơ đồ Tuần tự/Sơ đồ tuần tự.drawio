  <diagram id="uIbyvBSfqO9Fu0DrQtAu" name="phieuthanhlyts">
    <mxGraphModel dx="1042" dy="626" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml SD14_ThanhLyTaiSan\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam defaultFontSize 11\nskinparam backgroundColor white\nskinparam sequence {\n    ArrowColor #990033\n    ActorBorderColor #990033\n    LifeLineBorderColor #990033\n    LifeLineBackgroundColor white\n    ParticipantBorderColor #990033\n    ParticipantBackgroundColor #FFFEE0\n    ActorBackgroundColor #FFFEE0\n    GroupBorderColor #990033\n    GroupBackgroundColor transparent\n    GroupHeaderFontColor #990033\n}\n\nactor \&quot;: NVQuanLyTaiSan\&quot; as NV\nactor \&quot;: QuanLy\&quot; as QL\nboundary \&quot;: FrmThanhLy\&quot; as Form\ncontrol \&quot;: ThanhLyService\&quot; as Service\nentity \&quot;: PhieuThanhLy\&quot; as Phieu\nentity \&quot;: ChiTietThanhLy\&quot; as CT\nentity \&quot;: TaiSan\&quot; as TS\n\nNV -&gt; Form : moLapPhieuThanhLy()\nactivate Form\nForm -&gt; Service : layTaiSanChoThanhLy()\nactivate Service\nService -&gt; TS : timTheoTrangThai(\&quot;Cho thanh ly\&quot;)\nactivate TS\nTS --&gt; Service : dsChoThanhLy\ndeactivate TS\nService --&gt; Form : dsChoThanhLy\ndeactivate Service\nForm --&gt; NV : hienThiDanhSachTaiSan()\n\nNV -&gt; Form : chonTaiSan(dsMaTS), phuongThuc(ban/tieuHuy), giaTriThuHoi, lyDo\nNV -&gt; Form : nhan \&quot;Trinh phe duyet\&quot;\n\nForm -&gt; Service : lapHoSoThanhLy(dsMaTS, phuongThuc, giaTriThuHoi, lyDo)\nactivate Service\nService -&gt; Phieu : lapHoSoThanhLy(maPhieuTL, ngayTL, phuongThuc, \&quot;Cho phe duyet\&quot;)\nactivate Phieu\nPhieu --&gt; Service : phieuDaTao\ndeactivate Phieu\n\nloop [voi tung tai san thanh ly]\n    Service -&gt; TS : tinhKhauHaoHienTai(maTS)\n    activate TS\n    TS --&gt; Service : nguyenGia, giaTriConLai\n    deactivate TS\n    Service -&gt; CT : taoChiTietTL(maPhieuTL, maTS, nguyenGia, giaTriConLai)\n    activate CT\n    CT --&gt; Service : ok\n    deactivate CT\nend\n\nService -&gt; Service : guiThongBaoPheDuyet(maPhieuTL)\nService --&gt; Form : KetQua.TrinhDuyetOk\ndeactivate Service\nForm --&gt; NV : Thong bao da trinh phe duyet\n\n== Giai doan Quản lý phê duyệt ==\n\nQL -&gt; Form : xemHoSoThanhLy(maPhieuTL)\nForm --&gt; QL : hienThiThongTinVaChiTietTaiSan()\n\nalt [Quan ly dong y]\n    QL -&gt; Form : nhan \&quot;Phe duyet thanh ly\&quot;\n    Form -&gt; Service : pheDuyet(maPhieuTL, maQL, true)\n    activate Service\n    Service -&gt; Phieu : pheDuyetThanhLy(maPhieuTL, \&quot;Da phe duyet\&quot;)\n    activate Phieu\n    Phieu --&gt; Service : ok\n    deactivate Phieu\n    \n    loop [cap nhat trang thai tung tai san]\n        Service -&gt; TS : capNhatTinhTrang(maTS, \&quot;Da thanh ly\&quot;)\n        activate TS\n        TS --&gt; Service : ok\n        deactivate TS\n    end\n    Service --&gt; Form : KetQua.PheDuyetThanhCong\n    Form --&gt; QL : Thong bao da phe duyet thanh ly\nelse [Quan ly tu choi]\n    QL -&gt; Form : nhapLyDoTuChoi(lyDo)\n    QL -&gt; Form : nhan \&quot;Tu choi\&quot;\n    Form -&gt; Service : tuChoi(maPhieuTL, lyDo)\n    Service -&gt; Phieu : capNhatTrangThai(maPhieuTL, \&quot;Tu choi\&quot;)\n    activate Phieu\n    Phieu --&gt; Service : ok\n    deactivate Phieu\n    Service --&gt; Form : KetQua.DaTuChoi\n    deactivate Service\n    Form --&gt; QL : Thong bao da tu choi ho so\nend\n\ndeactivate Form\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="bcdXKPiDSdv9RzuAMlCT-1">
          <mxCell style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;participant=umlStickman;size=40;" connectable="0" vertex="1" parent="1">
            <mxGeometry x="100" y="390" width="1676.6842142857142" height="1455.8" as="geometry" />
