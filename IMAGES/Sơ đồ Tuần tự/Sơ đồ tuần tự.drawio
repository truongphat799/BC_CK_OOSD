        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml SD10_BaoTriSuaChua\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam defaultFontSize 11\nskinparam backgroundColor white\nskinparam sequence {\n    ArrowColor #990033\n    ActorBorderColor #990033\n    LifeLineBorderColor #990033\n    LifeLineBackgroundColor white\n    ParticipantBorderColor #990033\n    ParticipantBackgroundColor #FFFEE0\n    ActorBackgroundColor #FFFEE0\n    GroupBorderColor #990033\n    GroupBackgroundColor transparent\n    GroupHeaderFontColor #990033\n}\n\nactor \&quot;: NVQuanLyTaiSan\&quot; as NV\nboundary \&quot;: FrmBaoTri\&quot; as Form\ncontrol \&quot;: BaoTriService\&quot; as Service\nentity \&quot;: PhieuBaoTri\&quot; as Phieu\nentity \&quot;: ChiTietBaoTri\&quot; as CT\nentity \&quot;: TaiSan\&quot; as TS\n\nNV -&gt; Form : chonLapPhieuBaoTri()\nactivate Form\nForm --&gt; NV : hienThiBieuMauBM5(maPhieuTuDong)\n\nNV -&gt; Form : chonTaiSan(maTS), nhapNoiDungHuHong, donViSuaChua\nNV -&gt; Form : nhan \&quot;Tao phieu bao tri\&quot;\n\nForm -&gt; Service : taoPhieuBaoTri(maTS, noiDung, donViSua)\nactivate Service\nService -&gt; Phieu : lapPhieuBT(maPhieuBT, ngayLap, donViSua)\nactivate Phieu\nPhieu --&gt; Service : phieuDaTao\ndeactivate Phieu\n\nService -&gt; CT : taoChiTietBT(maPhieuBT, maTS, noiDung)\nactivate CT\nCT --&gt; Service : chiTietDaTao\ndeactivate CT\n\nService -&gt; TS : capNhatTinhTrang(maTS, \&quot;Dang bao tri\&quot;)\nactivate TS\nTS --&gt; Service : ok\ndeactivate TS\nService --&gt; Form : KetQua.Ok\nForm --&gt; NV : Thong bao bat dau bao tri\n\n== Sau khi sua chua xong ==\n\nNV -&gt; Form : nhapKetQuaBaoTri(maPhieuBT, chiPhi, ketQuaNghiemThu)\nNV -&gt; Form : nhan \&quot;Hoan thanh bao tri\&quot;\nForm -&gt; Service : hoanThanhBaoTri(maPhieuBT, chiPhi, ketQua)\n\nalt [nghiemThu == \&quot;Dat\&quot;]\n    Service -&gt; Phieu : nghiemThuKyThuat(maPhieuBT, chiPhi, \&quot;Dat\&quot;)\n    activate Phieu\n    Phieu --&gt; Service : ok\n    deactivate Phieu\n    Service -&gt; TS : capNhatTinhTrang(maTS, \&quot;Dang su dung\&quot;)\n    activate TS\n    TS --&gt; Service : ok\n    deactivate TS\n    Service --&gt; Form : KetQua.Success(\&quot;Bảo trì thành công\&quot;)\n    Form --&gt; NV : Thong bao hoan tat bao tri\nelse [nghiemThu == \&quot;Khong the phuc hoi\&quot;]\n    Service -&gt; Phieu : capNhatKetQua(maPhieuBT, chiPhi, \&quot;Hong nang\&quot;)\n    activate Phieu\n    Phieu --&gt; Service : ok\n    deactivate Phieu\n    Service -&gt; TS : capNhatTinhTrang(maTS, \&quot;Cho thanh ly\&quot;)\n    activate TS\n    TS --&gt; Service : ok\n    deactivate TS\n    Service --&gt; Form : KetQua.ChuyenThanhLy(\&quot;Tài sản chuyển sang Chờ thanh lý\&quot;)\n    Form --&gt; NV : Thong bao de xuat thanh ly\nend\n\ndeactivate Service\ndeactivate Form\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Jvbe49E1EvkwwdSjMYOJ-1">
          <mxCell style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" connectable="0" vertex="1" parent="1">
