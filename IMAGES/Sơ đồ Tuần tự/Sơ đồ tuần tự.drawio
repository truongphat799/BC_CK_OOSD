        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml SD03_TraCuuTaiSan\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam defaultFontSize 11\nskinparam backgroundColor white\nskinparam sequence {\n    ArrowColor #990033\n    ActorBorderColor #990033\n    LifeLineBorderColor #990033\n    LifeLineBackgroundColor white\n    ParticipantBorderColor #990033\n    ParticipantBackgroundColor #FFFEE0\n    ActorBackgroundColor #FFFEE0\n    GroupBorderColor #990033\n    GroupBackgroundColor transparent\n    GroupHeaderFontColor #990033\n}\n\nactor \&quot;: NhanVien\&quot; as NV\nboundary \&quot;: FrmTraCuuTaiSan\&quot; as Form\ncontrol \&quot;: TraCuuService\&quot; as Service\nentity \&quot;: TaiSan\&quot; as TS\nentity \&quot;: LoaiTaiSan\&quot; as Loai\nentity \&quot;: PhongBan\&quot; as PB\n\nNV -&gt; Form : moTrangTraCuu()\nactivate Form\nForm -&gt; Service : layDanhSachBoLoc()\nactivate Service\nService -&gt; Loai : layTatCaLoai()\nactivate Loai\nLoai --&gt; Service : dsLoai\ndeactivate Loai\nService -&gt; PB : layTatCaPhongBan()\nactivate PB\nPB --&gt; Service : dsPhongBan\ndeactivate PB\nService --&gt; Form : dsBoLoc(dsLoai, dsPhongBan)\ndeactivate Service\nForm --&gt; NV : hienThiGiaoDienTraCuu()\n\nNV -&gt; Form : nhapTieuChi(tuKhoa, maLoai, maPB, tinhTrang)\nNV -&gt; Form : nhan \&quot;Tim kiem\&quot;\nForm -&gt; Service : timKiemTaiSan(tieuChi)\nactivate Service\n\nService -&gt; TS : truyVanTaiSan(tieuChi)\nactivate TS\nTS --&gt; Service : ketQuaTimKiem\ndeactivate TS\n\nalt [co tai san thoa man]\n    Service --&gt; Form : KetQua.Ok(dsTaiSan)\n    Form --&gt; NV : hienThiBangKetQua(dsTaiSan)\n    \n    NV -&gt; Form : chonXemChiTiet(maTaiSan)\n    Form -&gt; Service : layChiTietTaiSan(maTaiSan)\n    Service -&gt; TS : timChiTiet(maTaiSan)\n    activate TS\n    TS --&gt; Service : thongTinChiTiet + lichSu\n    deactivate TS\n    Service --&gt; Form : duLieuChiTiet\n    Form --&gt; NV : hienThiPopupChiTietTaiSan()\nelse [khong tim thay ket qua]\n    Service --&gt; Form : KetQua.Empty\n    Form --&gt; NV : Thong bao \&quot;Không tìm thấy tài sản phù hợp\&quot;\nend\n\ndeactivate Service\ndeactivate Form\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mbd9lmSBZLPzRY0Y5n0x-1">
