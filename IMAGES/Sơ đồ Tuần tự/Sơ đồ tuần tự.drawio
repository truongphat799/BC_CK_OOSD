        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml SD11_DenBuHuHong\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam defaultFontSize 11\nskinparam backgroundColor white\nskinparam sequence {\n    ArrowColor #990033\n    ActorBorderColor #990033\n    LifeLineBorderColor #990033\n    LifeLineBackgroundColor white\n    ParticipantBorderColor #990033\n    ParticipantBackgroundColor #FFFEE0\n    ActorBackgroundColor #FFFEE0\n    GroupBorderColor #990033\n    GroupBackgroundColor transparent\n    GroupHeaderFontColor #990033\n}\n\nactor \&quot;: DonViSuDung\&quot; as DV\nactor \&quot;: NVQuanLyTaiSan\&quot; as NV\nboundary \&quot;: FrmDenBu\&quot; as Form\ncontrol \&quot;: DenBuService\&quot; as Service\nentity \&quot;: PhieuDenBu\&quot; as PhieuDB\nentity \&quot;: PhieuBaoTri\&quot; as PhieuBT\n\nNV -&gt; Form : moLapPhieuDenBu(maPhieuBT, maTS)\nactivate Form\nForm -&gt; Service : layThongTinThietHai(maPhieuBT)\nactivate Service\nService -&gt; PhieuBT : layChiPhiSuaChua(maPhieuBT)\nactivate PhieuBT\nPhieuBT --&gt; Service : chiPhiThucTe\ndeactivate PhieuBT\nService --&gt; Form : chiPhiThucTe\ndeactivate Service\nForm --&gt; NV : hienThiFormDenBu(chiPhiThucTe)\n\nNV -&gt; Form : nhapNguoiChiuTrachNhiem(maNV), tyLeBoiThuong, lyDo, hanChot\nNV -&gt; Form : nhan \&quot;Trinh ky bien ban den bu\&quot;\nForm -&gt; Service : taoBienBanDenBu(maPhieuBT, maNV, soTien, lyDo, hanChot)\nactivate Service\n\nService -&gt; PhieuDB : lapBienBanDenBu(maPhieuDB, soTien, lyDo, hanChot)\nactivate PhieuDB\nPhieuDB --&gt; Service : bienBanDaTao\ndeactivate PhieuDB\nService --&gt; Form : KetQua.ChoXacNhan(maPhieuDB)\ndeactivate Service\nForm --&gt; NV : Thong bao bien ban da chuyen cho nguoi dung\n\nDV -&gt; Form : xemBienBanDenBu(maPhieuDB)\nForm --&gt; DV : hienThiNoiDungVaSoTien()\n\nalt [Nguoi dung dong y xac nhan]\n    DV -&gt; Form : nhan \&quot;Xac nhan boi thuong\&quot;\n    Form -&gt; Service : xacNhanBoiThuong(maPhieuDB, maNV)\n    activate Service\n    Service -&gt; PhieuDB : xacNhanBoiThuong(maPhieuDB)\n    activate PhieuDB\n    PhieuDB --&gt; Service : ok\n    deactivate PhieuDB\n    Service --&gt; Form : KetQua.Ok\n    deactivate Service\n    Form --&gt; DV : Thong bao xac nhan thanh cong\nelse [Nguoi dung khieu nai]\n    DV -&gt; Form : nhapLyDoKhieuNai()\n    DV -&gt; Form : nhan \&quot;Khieu nai\&quot;\n    Form -&gt; Service : ghiNhanKhieuNai(maPhieuDB, lyDo)\n    activate Service\n    Service --&gt; Form : KetQua.DangKhieuNai\n    deactivate Service\n    Form --&gt; DV : Chuyen ho so sang Ban Quan ly giai quyet\nend\n\ndeactivate Form\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FgF8_X_bMO-iCXXNoxB8-1">
