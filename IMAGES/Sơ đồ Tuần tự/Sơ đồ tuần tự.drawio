        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml SD09_DieuChuyenTaiSan\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam defaultFontSize 11\nskinparam backgroundColor white\nskinparam sequence {\n    ArrowColor #990033\n    ActorBorderColor #990033\n    LifeLineBorderColor #990033\n    LifeLineBackgroundColor white\n    ParticipantBorderColor #990033\n    ParticipantBackgroundColor #FFFEE0\n    ActorBackgroundColor #FFFEE0\n    GroupBorderColor #990033\n    GroupBackgroundColor transparent\n    GroupHeaderFontColor #990033\n}\n\nactor \&quot;: NVQuanLyTaiSan\&quot; as NV\nboundary \&quot;: FrmDieuChuyen\&quot; as Form\ncontrol \&quot;: DieuChuyenService\&quot; as Service\nentity \&quot;: PhieuDieuChuyen\&quot; as Phieu\nentity \&quot;: ChiTietDieuChuyen\&quot; as CT\nentity \&quot;: TaiSan\&quot; as TS\n\nNV -&gt; Form : chonLapPhieuDieuChuyen()\nactivate Form\nForm --&gt; NV : hienThiBieuMauBM4(soPhieuTuDong, ngayDieuChuyen)\n\nNV -&gt; Form : chonDonViChuyen(maPBChuyen), chonDonViNhan(maPBNhan)\nNV -&gt; Form : nhapLyDoDieuChuyen(lyDo)\n\nForm -&gt; Service : layTaiSanTheoPhong(maPBChuyen)\nactivate Service\nService -&gt; TS : timTheoPhongBan(maPBChuyen)\nactivate TS\nTS --&gt; Service : dsTaiSanPBChuyen\ndeactivate TS\nService --&gt; Form : dsTaiSanPBChuyen\ndeactivate Service\nForm --&gt; NV : hienThiDanhSachChon(dsTaiSanPBChuyen)\n\nNV -&gt; Form : chonTaiSan(dsMaTS, viTriMoi)\nNV -&gt; Form : nhan \&quot;Luu dieu chuyen\&quot;\n\nForm -&gt; Service : lapPhieuDieuChuyen(maPBChuyen, maPBNhan, lyDo, dsMaTS, viTriMoi)\nactivate Service\n\nalt [maPBChuyen != maPBNhan]\n    Service -&gt; Phieu : taoPhieuDC(maPhieuDC, ngayDC, lyDo, maPBChuyen, maPBNhan)\n    activate Phieu\n    Phieu --&gt; Service : phieuDCDaTao\n    deactivate Phieu\n    \n    loop [voi tung tai san dieu chuyen]\n        Service -&gt; CT : taoChiTietDC(maPhieuDC, maTS, 1, viTriMoi)\n        activate CT\n        CT --&gt; Service : ok\n        deactivate CT\n        \n        Service -&gt; TS : capNhatDonViQuanLy(maTS, maPBNhan)\n        activate TS\n        Service -&gt; TS : capNhatViTri(maTS, viTriMoi)\n        TS --&gt; Service : daCapNhat\n        deactivate TS\n    end\n    \n    Service --&gt; Form : KetQua.Ok(maPhieuDC)\n    Form --&gt; NV : Thong bao dieu chuyen thanh cong\nelse [maPBChuyen == maPBNhan]\n    Service --&gt; Form : KetQua.Fail(\&quot;Đơn vị nhận phải khác đơn vị chuyển\&quot;)\n    Form --&gt; NV : Thong bao loi\nend\n\ndeactivate Service\ndeactivate Form\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="z6oo9dW_Mr8fo4ZAX4sn-1">
