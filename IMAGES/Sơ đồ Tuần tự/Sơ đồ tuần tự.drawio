        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml SD06_TiepNhanTaiSanCoDinh\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam defaultFontSize 11\nskinparam backgroundColor white\nskinparam sequence {\n    ArrowColor #990033\n    ActorBorderColor #990033\n    LifeLineBorderColor #990033\n    LifeLineBackgroundColor white\n    ParticipantBorderColor #990033\n    ParticipantBackgroundColor #FFFEE0\n    ActorBackgroundColor #FFFEE0\n    GroupBorderColor #990033\n    GroupBackgroundColor transparent\n    GroupHeaderFontColor #990033\n}\n\nactor \&quot;: NVQuanLyTaiSan\&quot; as NV\nboundary \&quot;: FrmTiepNhanTaiSan\&quot; as Form\ncontrol \&quot;: TiepNhanService\&quot; as Service\nentity \&quot;: TaiSan\&quot; as TS\nentity \&quot;: NhaCungCap\&quot; as NCC\n\nNV -&gt; Form : chonTiepNhanTaiSanMoi()\nactivate Form\nForm --&gt; NV : hienThiBieuMauBM2()\n\nNV -&gt; Form : nhapThongTinChung(ngayNhan, maNCC, soHD)\nNV -&gt; Form : themChiTiet(tenTS, maLoai, donViTinh, soLuong, nguyenGia, namSX)\nForm --&gt; NV : themVaoDanhSachTam()\n\nNV -&gt; Form : nhan \&quot;Luu tiep nhan\&quot;\nForm -&gt; Service : tiepNhanTaiSan(ttChung, dsChiTiet)\nactivate Service\n\nService -&gt; NCC : kiemTraNCC(maNCC)\nactivate NCC\nNCC --&gt; Service : nccHopLe\ndeactivate NCC\n\nalt [du lieu day du va hop le]\n    loop [voi tung tai san trong danh sach]\n        Service -&gt; TS : sinhMaTaiSanTuDong()\n        activate TS\n        TS --&gt; Service : maTSMoi\n        deactivate TS\n        Service -&gt; TS : themTaiSan(maTSMoi, tenTS, nguyenGia, \&quot;Trong kho\&quot;, ...)\n        activate TS\n        TS --&gt; Service : taiSanDaLuu\n        deactivate TS\n    end\n    Service --&gt; Form : KetQua.Ok(dsMaTSMoi)\n    Form --&gt; NV : Thong bao tiep nhan thanh cong va danh sach ma TS\nelse [thieu thong tin bat buoc]\n    Service --&gt; Form : KetQua.Fail(\&quot;Thiếu thông tin bắt buộc\&quot;)\n    Form --&gt; NV : Thong bao loi yeu cau nhap lai\nend\n\ndeactivate Service\ndeactivate Form\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="jcRN7ln5OiO7s7vY-4ZN-1">
