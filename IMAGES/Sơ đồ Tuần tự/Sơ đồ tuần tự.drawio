        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml SD15_BaoCaoThongKe\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam defaultFontSize 11\nskinparam backgroundColor white\nskinparam sequence {\n    ArrowColor #990033\n    ActorBorderColor #990033\n    LifeLineBorderColor #990033\n    LifeLineBackgroundColor white\n    ParticipantBorderColor #990033\n    ParticipantBackgroundColor #FFFEE0\n    ActorBackgroundColor #FFFEE0\n    GroupBorderColor #990033\n    GroupBackgroundColor transparent\n    GroupHeaderFontColor #990033\n}\n\nactor \&quot;: QuanLy\&quot; as QL\nboundary \&quot;: FrmBaoCaoThongKe\&quot; as Form\ncontrol \&quot;: BaoCaoService\&quot; as Service\nentity \&quot;: TaiSan\&quot; as TS\nentity \&quot;: LoaiTaiSan\&quot; as Loai\nentity \&quot;: PhongBan\&quot; as PB\n\nQL -&gt; Form : moTrangBaoCaoThongKe()\nactivate Form\nForm --&gt; QL : hienThiBieuMauBM8(cacBoLoc)\n\nQL -&gt; Form : chonKyBaoCao(tuNgay, denNgay)\nQL -&gt; Form : chonBoLoc(maLoai, maPB, tinhTrang)\nQL -&gt; Form : nhan \&quot;Xem bao cao\&quot;\n\nForm -&gt; Service : thongKeTaiSan(tuNgay, denNgay, maLoai, maPB, tinhTrang)\nactivate Service\n\nService -&gt; TS : truyVanDuLieuBaoCao(boLoc)\nactivate TS\nTS --&gt; Service : dsTaiSanThoaMan\ndeactivate TS\n\nService -&gt; Service : tinhTongSoLuong(dsTaiSanThoaMan)\nService -&gt; Service : tinhTongNguyenGia(dsTaiSanThoaMan)\nService -&gt; Service : phanLoaiTheoTinhTrang()\nService -&gt; Service : tinhGiaTriHaoMonConLai()\n\nalt [co du lieu thoa man]\n    Service --&gt; Form : KetQua.Ok(bangTongHop, dsChiTiet)\n    Form --&gt; QL : hienThiBangThongKeVaBieuDo()\n    \n    opt [Quan ly muon xuat file Excel]\n        QL -&gt; Form : nhan \&quot;Xuat Excel\&quot;\n        Form -&gt; Service : taoFileExcel(duLieu)\n        Service -&gt; Service : renderExcelTemplate()\n        Service --&gt; Form : fileExcelBlob\n        Form --&gt; QL : taiFileVeMay(\&quot;BaoCaoTaiSan.xlsx\&quot;)\n    end\nelse [khong co du lieu]\n    Service --&gt; Form : KetQua.Empty\n    Form --&gt; QL : Thong bao \&quot;Không có biến động trong kỳ báo cáo\&quot;\nend\n\ndeactivate Service\ndeactivate Form\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="86IIoYyO-eSckC7uhmJ_-1">
